# LLM Provider (optional, default: anthropic)
# Options: anthropic | openai | deepseek
LLM_PROVIDER=anthropic

# LLM Model (optional, default: claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6

# LLM Base URL (optional, for proxy or compatible APIs)
# Examples:
#   https://your-proxy.example.com/v1
#   https://api.deepseek.com/v1
LLM_BASE_URL=

# LLM API Key (required, choose one)
# Generic key (works for all providers)
LLM_API_KEY=your_api_key_here

# Or provider-specific keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
DEEPSEEK_API_KEY=sk-xxxxx
